FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

thermoType
{
    type            hePsiThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   352.02;      // UF6 (kg/mol)
    }

    thermodynamics
    {
        Cp          385;        // Your Cp value (J/kg·K)
        Hf          0;
    }

    transport
    {
        mu          2.0e-05;  // Dynamic viscosity [Pa·s]
        Pr          0.97;     // Prandtl number
    }
}

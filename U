FoamFile
{
    format      binary;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    axis
    {
        type            symmetryPlane;
	value		uniform (0 0 0);
    }
    rotorWall
    {
        type            rotatingWallVelocity;
        origin          (0 0 0);

	axis		(0 0 1);

	omega		1500;

	value		uniform (0 0 0);
    }
    bottom
    {
        type            noSlip;
        value           uniform (0 0 0);
    }
    top
    {
        type            noSlip;
        value           uniform (0 0 0);
    }
    wedgeFront
    {
        type            wedge;
        value           uniform (0 0 0);

    }
    wedgeBack
    {
        type            wedge;
        value           uniform (0 0 0);

    }
}


